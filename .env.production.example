# =============================================================================
# HRM Laravel Base — Production Environment Reference
# -----------------------------------------------------------------------------
# Copy this file to a secret-managed location (NOT git) as `.env.production`
# and symlink it into every release as `/opt/hrm/shared/.env`.
#
# Every value below is REQUIRED unless marked optional. Never commit real
# secrets. All production variables live in `shared/.env` on the server.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_NAME=hrm-laravel-base
APP_ENV=production
# `php artisan key:generate --force` on first bootstrap, then keep stable
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_DEBUG=false
# Public HTTPS URL. Keep in sync with SESSION_DOMAIN below (null is safest).
APP_URL=https://hrm.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Use file-based maintenance mode in production (no DB dependency during outages)
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL 8.0 production — required for Blue/Green) --------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm_production
DB_USERNAME=hrm_user
DB_PASSWORD=CHANGE_ME
# Optional socket config for PHP-FPM pool over TCP
# DB_UNIX_SOCKET=/var/run/mysqld/mysqld.sock
# Optional: use utf8mb4 explicitly
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# --- Sessions & Cache -------------------------------------------------------
# Must be DB-backed so sessions survive release swaps and horizontal scale.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null = host-only cookie. Only set this to the exact APP_URL host (with the
# leading dot rules) if you intentionally share cookies across subdomains.
# A mismatch with APP_URL causes HTTP 419 / "cookie rejected for invalid
# domain" on login :: set null for a single-host deployment.
SESSION_DOMAIN=null
# Set when the site is served over HTTPS (recommended for production).
SESSION_SECURE_COOKIE=true
# Use a dedicated cache store; file/database acceptable, Redis recommended.
CACHE_STORE=database
CACHE_PREFIX=hrm_prod_

# --- Queue -------------------------------------------------------------------
# Database queue is production-safe and survives `queue:restart` on swap.
QUEUE_CONNECTION=database

# --- Mail --------------------------------------------------------------------
# Production SMTP relay; never default to `log` in real deployments.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=hrm-smtp-user
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@hrm.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Files / Storage ----------------------------------------------------------
FILESYSTEM_DISK=local
# If S3/object storage is used for documents/payslips:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Broadcast / Reverb --------------------------------------------------------
BROADCAST_CONNECTION=log

# --- Frontend ------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Blue/Green runtime flags (consumed by scripts/deploy-bluegreen.sh) --------
# Optional: enable Laravel Pulse / uptime endpoint
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/notify